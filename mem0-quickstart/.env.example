# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  .env 는 git에 올라가지 않는다.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# 한 파일에 여러 경로를 다 적어 두면 섞이기 쉬우니,
# 지금 실습할 경로 하나만 주석을 풀어 쓰는 것을 권한다.
# (모델명을 비워 두면 config.py의 기본값이 쓰인다)
# ─────────────────────────────────────────────────────────────

# ── 경로 A: OpenAI ───────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
#   MEM0_LLM_MODEL=gpt-4o-mini              # 기본값
#   MEM0_EMBED_MODEL=text-embedding-3-small # 기본값 (1536차원)

# ── 경로 B: 완전 로컬 (Ollama) ───────────────────────────────
# `ollama pull qwen2.5:14b`  /  `ollama pull nomic-embed-text` 후 사용
#   MEM0_LLM_MODEL=qwen2.5:14b
#   MEM0_EMBED_MODEL=nomic-embed-text
#   MEM0_EMBED_DIMS=768
#   OLLAMA_BASE_URL=http://localhost:11434

# ── 경로 C: OpenAI 호환 엔드포인트 ───────────────────────────
# vLLM · LM Studio · Ollama 의 /v1 · OpenRouter · Groq 등
# OPENAI_BASE_URL=http://localhost:11434/v1
# MEM0_LLM_MODEL=qwen2.5:14b
# MEM0_EMBED_MODEL=nomic-embed-text
# MEM0_EMBED_DIMS=768
#
# 임베딩 서버가 LLM과 다르면 따로 지정:
# MEM0_EMBED_BASE_URL=https://api.openai.com/v1
#
# 로컬 서버는 보통 키를 확인하지 않으므로 아무 문자열이나 된다.
# MEM0_COMPAT_API_KEY=not-needed
#
# 실제 예시
#   LM Studio : OPENAI_BASE_URL=http://localhost:1234/v1 , MEM0_LLM_MODEL=qwen2.5-14b-instruct
#   vLLM      : OPENAI_BASE_URL=http://localhost:8000/v1 , MEM0_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 , MEM0_LLM_MODEL=qwen/qwen-2.5-72b-instruct
#               (OpenRouter는 임베딩을 제공하지 않으므로 MEM0_EMBED_BASE_URL 필요)
#   Groq      : OPENAI_BASE_URL=https://api.groq.com/openai/v1 , MEM0_LLM_MODEL=llama-3.3-70b-versatile

# ── 경로 D: NVIDIA NIM (NVIDIA API Catalog) ─────────────────
# 키: https://build.nvidia.com/settings  (모델 페이지의 "Get API Key"도 같은 키, `nvapi-` 로 시작)
# NVIDIA Developer Program 가입은 무료이고 카드 정보를 요구하지 않는다.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#
# 모델명을 바꾸려면 아래 주석을 풀고 카탈로그에 있는 이름을 넣는다.
#   MEM0_LLM_MODEL=meta/llama-3.3-70b-instruct
#   MEM0_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1
#   MEM0_EMBED_DIMS=2048
#
# 다른 LLM 예 (build.nvidia.com 카탈로그에 있는 이름):
#   nvidia/nemotron-3.5-lightning-30b-a3b   (빠름)
#   nvidia/nemotron-3-ultra-550b-a55b       (품질 우선)
#   moonshotai/kimi-k3.1-pro
#
# 임베딩 주의: nv-embedqa / nv-embed / nemotron-…-embed 계열은 NIM이
# input_type(passage/query)을 요구하고, mem0의 OpenAI 임베더는 이 필드를 보내지 않는다.
# demo.py가 nim_embedder.py로 감싸서 자동으로 처리하지만, 직접 코드를 쓸 때는
# attach_nim_embedder(memory)를 꼭 호출할 것. README의 "NVIDIA NIM으로 실행하기" 참고.
#
# 대칭형 대안: snowflake/arctic-embed-l (1024차원, 영어 중심이라 한국어에는 권하지 않음)

# ── 저장 위치 (선택) ────────────────────────────────────────
# 비워 두면 mem0-quickstart/data/ 를 쓴다. (gitignore 대상)
# MEM0_DATA_DIR=D:\mem0-data
